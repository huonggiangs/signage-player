<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- LAN dùng HTTP nội bộ nên cho phép cleartext mặc định; ams.anio.vn luôn bắt buộc HTTPS -->
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">anio.vn</domain>
    </domain-config>
</network-security-config>
